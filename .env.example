# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local PostgreSQL (see README). Replace YOUR_PASSWORD with the one you chose at install.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/epsilon

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
OTP_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth *web* client ID(s), comma-separated. Empty = Google sign-in rejected.
GOOGLE_CLIENT_IDS=

# console = print OTP codes in the server log (development only; refused in production)
SMS_PROVIDER=console

MIN_APP_VERSION=0.1.0
MIN_AGE=16
REQUIRE_PHONE_VERIFICATION=true

# Browser origins allowed to call the API, comma-separated (e.g. Expo web: http://localhost:8081). Empty = none.
CORS_ORIGINS=

# Fiscal receipts (e-kassa). `none` until an authorised integration exists (production default).
# `fixture` serves local test receipts from private-fixtures/fiscal/*.json (shown in the app as "Test data").
FISCAL_PROVIDER=none

# Gemini: reads customer-supplied receipt images and suggests unknown business sectors.
# Server-side only; never put the key in the app.
# Off by default: no Gemini request is made unless GEMINI_ENABLED=true.
GEMINI_ENABLED=false
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Requests per imported receipt image (reading and sector suggestion share one request).
GEMINI_MAX_CALLS_PER_RECEIPT=1
# Largest accepted receipt image, bytes.
MAX_RECEIPT_IMAGE_BYTES=6000000
# Application cap on Gemini requests per day (Google's free-tier limits apply separately).
GEMINI_MAX_CALLS_PER_DAY=5

# Partner POS integration: issue a key per partner restaurant with
#   npm run partner:key -- <restaurantId>
# Its POS then sends each sale to POST /v1/partner/receipts (header X-Partner-Key).
