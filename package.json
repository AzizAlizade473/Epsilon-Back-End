{
  "name": "epsilon-back-end",
  "version": "1.0.0",
  "description": "Epsilon mobile app API (Fastify + PostgreSQL + Drizzle)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:contract": "vitest run -c test/_contract/vitest.config.mts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
