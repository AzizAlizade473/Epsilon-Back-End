{
  "name": "epsilon-back-end",
  "version": "1.0.0",
  "description": "Epsilon mobile app API (Fastify + PostgreSQL + Drizzle)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:contract": "vitest run -c test/_contract/vitest.config.mts",
    "db:studio": "drizzle-kit studio",
    "partner:key": "tsx --env-file=.env src/db/partner-key.ts",
    "notify:partner": "tsx --env-file=.env src/db/announce-partner.ts",
    "admin:add": "tsx --env-file=.env src/admin/cli.ts add",
    "admin:disable": "tsx --env-file=.env src/admin/cli.ts disable",
    "admin:revoke": "tsx --env-file=.env src/admin/cli.ts revoke"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@google/genai": "^3.4.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-table": "9.3.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "i18next": "27.2.7",
    "jose": "^6.2.17",
    "lucide-react": "1.79.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "react-router": "7.18.6",
    "recharts": "3.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
